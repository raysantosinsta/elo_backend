# NOTA: Este arquivo não utiliza variáveis de ambiente ou captura automática de tokens.
# Você deve substituir manualmente todos os placeholders (ex: http://localhost:3000)
# e inserir os tokens gerados nos campos apropriados (ex: <INSERT_ACCESS_TOKEN_HERE>).

#==============================================
# 1. LOGIN
# Endpoint: POST /auth/login
# Descrição: Autentica o usuário e recebe os tokens no corpo da resposta.
#==============================================
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "email": "santosray62@gmail.com",
    "password": "Blessedhr10@"
}

### Resposta de LOGIN
# Capture o "accessToken" e "refreshToken" da resposta abaixo e use nas requisições seguintes.


#==============================================
# 2. PERFIL
# Endpoint: GET /auth/profile
# Descrição: Acessa o perfil do usuário logado.
# Requer o Access Token no header Authorization.
#==============================================
GET http://localhost:3000/auth/profile
Authorization: Bearer <INSERT_ACCESS_TOKEN_HERE>


#==============================================
# 3. REFRESH TOKEN
# Endpoint: POST /auth/refresh
# Descrição: Usa o Refresh Token para obter um novo par de tokens.
#==============================================
POST http://localhost:3000/auth/refresh
Content-Type: application/json

{
    "refreshToken": "<INSERT_REFRESH_TOKEN_HERE>"
}

### Resposta de REFRESH
# O novo "accessToken" e "refreshToken" estarão no corpo.


#==============================================
# 4. VERIFY TOKEN (Validação)
# Endpoint: POST /auth/verify-token
# Descrição: Verifica a validade do Access Token atual.
#==============================================
POST http://localhost:3000/auth/verify-token
Content-Type: application/json

{
    "token": "<INSERT_ACCESS_TOKEN_HERE>"
}