@baseUrl = http://localhost:3000
@contentType = application/json

# --- VARIÁVEIS DE AMBIENTE ---
# Cole seu token JWT válido aqui (logado como MASTER ou ADMIN para testar criar/editar)
@token = <COLE_SEU_ACCESS_TOKEN_AQUI>

# IDs para teste (Preencha após criar uma empresa ou um usuário)
@companyId = <COLE_UM_UUID_DE_EMPRESA_VALIDO>
@userId = <COLE_UM_UUID_DE_USUARIO_PARA_EDITAR_OU_DELETAR>


# ==============================================================================
# 1. ESCRITA (WRITE OPERATIONS) - Requer MASTER ou ADMIN
# ==============================================================================

### Criar Novo Usuário
# Requer: MASTER ou ADMIN
# Payload: CreateUserDto
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "name": "Funcionário Teste",
    "email": "funcionario.teste@exemplo.com",
    "password": "SenhaSegura123!",
    "role": "EMPLOYER",
    "contact": "11999998888",
    "document": "12345678900",
    "professionalRole": "Gerente de Vendas",
    "companyId": "{{companyId}}"
}

### Atualizar Usuário
# Requer: MASTER ou ADMIN
# Payload: UpdateUserDto (Parcial)
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "name": "Funcionário Atualizado",
    "professionalRole": "Diretor Comercial"
}

### Alternar Status (Ativar/Inativar)
# Requer: MASTER ou ADMIN
# Params: status deve ser um Enum SimpleStatus válido (ex: ACTIVE, INACTIVE, BLOCKED)
PATCH {{baseUrl}}/users/{{userId}}/status/INACTIVE
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

### Remover Usuário (Hard Delete)
# Requer: MASTER (Apenas)
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}


# ==============================================================================
# 2. LEITURA (READ OPERATIONS)
# ==============================================================================

### Listar Todos (Com Filtros e Paginação)
# Requer: MASTER ou ADMIN
# Query Params: page, limit, companyId, status, role
GET {{baseUrl}}/users?page=1&limit=10&status=ACTIVE
Authorization: Bearer {{token}}

### Listar Todos Filtrando por Empresa
# Requer: MASTER ou ADMIN
GET {{baseUrl}}/users?page=1&limit=10&companyId={{companyId}}
Authorization: Bearer {{token}}

### Listar Usuários de uma Empresa Específica (Rota Dedicada)
# Requer: MASTER, ADMIN
GET {{baseUrl}}/users/company/{{companyId}}
Authorization: Bearer {{token}}

### Buscar por ID
# Requer: Autenticação válida
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}


# ==============================================================================
# 3. BUSCA (SEARCH)
# ==============================================================================

### Pesquisar Usuário (Nome ou Email)
# Busca dentro da empresa do usuário logado (ou companyId informado se for Admin/Master)
GET {{baseUrl}}/users/search?query=funciona
Authorization: Bearer {{token}}

### Pesquisar Usuário em Empresa Específica
GET {{baseUrl}}/users/search?query=teste&companyId={{companyId}}
Authorization: Bearer {{token}}