### -------------------------------------------------------
### 3. LISTAGEM (GET ALL) - Filtro de Segurança
### -------------------------------------------------------

# [SUCESSO] Listar Tudo como MASTER
# Deve retornar TODAS as empresas
GET {{baseUrl}}/companies?page=1&limit=10
Authorization: Bearer {{tokenMaster}}

###

# [SUCESSO PARCIAL] Listar como ADMIN
# O Controller permite, mas o Service deve filtrar e retornar APENAS a empresa do Admin.
# Verifique se o array 'data' contém apenas 1 item (a empresa dele).
GET {{baseUrl}}/companies?page=1&limit=10
Authorization: Bearer {{tokenAdmin}}

### -------------------------------------------------------
### 4. BUSCA POR ID (GET ONE) - Teste de IDOR
### -------------------------------------------------------

# [SUCESSO] Buscar ID Específico como MASTER
# O Master pode ver qualquer ID.
GET {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenMaster}}

###

# [SUCESSO] Buscar a PRÓPRIA empresa como ADMIN
# O ID na URL deve ser igual ao companyId dentro do token do Admin.
GET {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenAdmin}}

###

# [ERRO DE SEGURANÇA] Buscar OUTRA empresa como ADMIN (IDOR)
# O Admin tenta acessar o ID de outra empresa.
# Deve retornar 403 Forbidden (Nossa regra de segurança no Service).
GET {{baseUrl}}/companies/{{otherCompanyId}}
Authorization: Bearer {{tokenAdmin}}

### -------------------------------------------------------
### 5. ATUALIZAÇÃO (PATCH) - Regras de Negócio
### -------------------------------------------------------

# [SUCESSO] MASTER atualiza qualquer dado
PATCH {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{tokenMaster}}

{
  "name": "Nome Alterado pelo Master",
  "ramoAtividade": "Alta Costura"
}

###

# [SUCESSO] ADMIN atualiza sua PRÓPRIA empresa
PATCH {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "telefone": "11988887777",
  "complemento": "Galpão B"
}

###

# [ERRO] ADMIN tenta INATIVAR a própria empresa
# Regra de Negócio: Só Master pode inativar (cancelar contrato).
# Deve retornar 403 Forbidden.
PATCH {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "status": "INACTIVE"
}

###

# [ERRO] ADMIN tenta alterar OUTRA empresa (IDOR)
PATCH {{baseUrl}}/companies/{{otherCompanyId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Hacked by Admin"
}

### -------------------------------------------------------
### 6. REMOÇÃO (DELETE) - Soft Delete
### -------------------------------------------------------

# [ERRO] ADMIN tenta deletar empresa
# Deve retornar 403 Forbidden
DELETE {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenAdmin}}

###

# [SUCESSO] MASTER inativa (Soft Delete) a empresa
# Deve retornar 204 No Content
DELETE {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenMaster}}