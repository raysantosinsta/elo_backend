generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationSourceType {
  SYSTEM
  TASK
  ROUTE
}

enum RouteStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum UserRole {
  MASTER
  ADMIN
  EMPLOYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  BUDGET_APPROVED
  BUDGET_PENDING_APPROVAL
  BUDGET_REJECTED
  SYSTEM_ALERT
  PAYMENT_REMINDER
  TASK_OVERDUE
  NEW_MESSAGE
  COLLECTION_LAUNCHED
  LOW_STOCK_ALERT
}

enum CompanyStatus {
  ATIVO
  INATIVO
}

enum KanbanColumnStatus {
  ACTIVE
  ARCHIVED
}

model Company {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  status        CompanyStatus @default(ATIVO) @map("status")
  name          String        @map("nome") @db.VarChar(150)
  cnpj          String        @unique @map("cnpj") @db.VarChar(18)
  telefone      String        @map("telefone") @db.VarChar(20)
  email         String        @map("email") @db.VarChar(255)
  endereco      String        @map("endereco") @db.VarChar(300)
  numero        String        @map("numero") @db.VarChar(10)
  complemento   String?       @map("complemento") @db.VarChar(100)
  bairro        String        @map("bairro") @db.VarChar(100)
  cidade        String        @map("cidade") @db.VarChar(100)
  estado        String        @map("estado") @db.VarChar(2)
  cep           String        @map("cep") @db.VarChar(9)
  ramoAtividade String?       @map("ramo_atividade") @db.VarChar(100)

  userCreate   User?    @relation("CompanyCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String?  @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("data_de_criacao")

  userUpdate   User?    @relation("CompanyUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  users         User[]         @relation("CompanyMembers")
  kanbanCols    KanbanColumn[]
  tasks         Task[]
  notifications Notification[]
  materials     Material[]
  products      Product[]
  budgets       Budget[]
  routes        Route[]
  taskImages    TaskImage[]
  taskAudios    TaskAudio[]
  taskVideos    TaskVideo[]
  taskAddresses TaskAddress[]
  chats         Chat[]
  collections   Collection[]
  productFlows  ProductFlow[]
  flowItems     FlowItem[]
  flowImages    FlowImage[]
  flowAudios    FlowAudio[]
  flowVideos    FlowVideo[]

  @@index([cnpj])
  @@index([status])
  @@index([createdAt])
  @@map("empresas")
}

model User {
  id               String     @id @default(uuid()) @map("id") @db.Uuid
  status           UserStatus @default(ACTIVE) @map("status")
  name             String     @map("nome") @db.VarChar(150)
  email            String     @unique @map("email") @db.VarChar(255)
  document         String?    @unique @map("documento") @db.VarChar(20)
  password         String     @map("senha") @db.VarChar(255)
  role             UserRole   @map("perfil")
  isProfessional   Boolean    @default(false) @map("profissional")
  professionalRole String?    @map("cargo_profissional") @db.VarChar(100)
  phone            String     @map("telefone") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  createdCompanies     Company[]      @relation("CompanyCreatedBy")
  updatedCompanies     Company[]      @relation("CompanyUpdatedBy")
  createdTasks         Task[]         @relation("TaskCreatedBy")
  updatedTasks         Task[]         @relation("TaskUpdatedBy")
  completedTasks       Task[]         @relation("TaskCompletedBy")
  assignedTasks        Task[]         @relation("TaskAssignedTo")
  createdBudgets       Budget[]       @relation("CreatedBudgets")
  assignedBudgets      Budget[]       @relation("AssignedBudgets")
  createdKanbanColumns KanbanColumn[] @relation("CreatedKanbanColumns")
  updatedKanbanColumns KanbanColumn[] @relation("UpdatedKanbanColumns")
  createdRoutes        Route[]        @relation("RouteCreatedBy")
  updatedRoutes        Route[]        @relation("RouteUpdatedBy")
  assignedRoutes       Route[]        @relation("RouteAssignedUser")
  ownedKanbanColumns   KanbanColumn[] @relation("KanbanColumnOwner")

  notifications       UserNotification[]
  sentMessages        ChatMessage[]      @relation("UserSentMessages")
  mentionedInMessages ChatMessage[]      @relation("MentionedProfessional")
  uploadedImages      TaskImage[]
  uploadedAudios      TaskAudio[]
  uploadedVideos      TaskVideo[]

  company    Company?    @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String?     @map("empresa_id") @db.Uuid
  flowItems  FlowItem[]
  flowImages FlowImage[]
  flowAudios FlowAudio[]
  flowVideos FlowVideo[]

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("usuarios")
}

model KanbanColumn {
  id          String             @id @default(uuid()) @map("id") @db.Uuid
  status      KanbanColumnStatus @default(ACTIVE)
  description String             @map("descricao") @db.Text
  title       String             @map("titulo") @db.Text
  order       Int                @default(0) @map("ordem")
  createdAt   DateTime           @default(now()) @map("criado_em")
  updatedAt   DateTime           @updatedAt @map("atualizado_em")

  companyId String?  @map("empresa_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdBy   User?   @relation("CreatedKanbanColumns", fields: [createdById], references: [id])
  createdById String? @map("criado_por_id") @db.Uuid

  updatedBy   User?   @relation("UpdatedKanbanColumns", fields: [updatedById], references: [id])
  updatedById String? @map("atualizado_por_id") @db.Uuid

  owner   User?   @relation("KanbanColumnOwner", fields: [ownerId], references: [id])
  ownerId String? @map("owner_id") @db.Uuid

  tasks Task[]

  @@unique([companyId, title], name: "empresa_titulo")
  @@index([companyId])
  @@index([order])
  @@map("colunas_kanban")
}

model Task {
  id             String     @id @default(uuid()) @map("id") @db.Uuid
  title          String     @map("titulo") @db.VarChar(200)
  description    String?    @map("descricao") @db.Text
  dueDate        DateTime?  @map("prazo")
  status         TaskStatus @default(PENDING) @map("status")
  priority       Int        @default(1) @map("prioridade")
  scheduledAt    DateTime   @default(now()) @map("agendado_para")
  completedAt    DateTime?  @map("concluido_em")
  failedAt       DateTime?  @map("falhou_em")
  finalComment   String?    @map("comentario_final") @db.Text
  scheduledDate  DateTime?
  completionDate DateTime?
  columnOrder    Int        @default(0) @map("ordem_coluna")

  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String? @map("user_assigned_id") @db.Uuid

  completedBy   User?   @relation("TaskCompletedBy", fields: [completedById], references: [id])
  completedById String? @map("user_completed_id") @db.Uuid

  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String   @map("user_create_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("criado_em")

  updatedBy   User?    @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?  @map("user_update_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  columnId String       @map("coluna_id") @db.Uuid
  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  routeId String? @map("rota_id") @db.Uuid
  route   Route?  @relation(fields: [routeId], references: [id])

  notifications Notification[]
  budgets       Budget[]
  taskImages    TaskImage[]
  taskAudios    TaskAudio[]
  taskVideos    TaskVideo[]
  taskAddress   TaskAddress?

  @@index([companyId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([dueDate, status])
  @@index([assignedToId, status])
  @@index([routeId])
  @@map("tarefas")
}

model TaskAddress {
  id          String  @id @default(uuid()) @map("id") @db.Uuid
  cep         String  @map("cep") @db.VarChar(8)
  endereco    String  @map("endereco") @db.VarChar(200)
  numero      String  @map("numero") @db.VarChar(10)
  bairro      String  @map("bairro") @db.VarChar(100)
  cidade      String  @map("cidade") @db.VarChar(100)
  estado      String  @map("estado") @db.VarChar(2)
  complemento String? @map("complemento") @db.VarChar(100)

  taskId    String   @unique @map("tarefa_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.Uuid

  @@index([taskId])
  @@map("enderecos_tarefas")
}

model TaskImage {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String @map("user_upload_id") @db.Uuid

  @@index([companyId])
  @@index([taskId])
  @@map("imagens_tarefas")
}

model TaskAudio {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  duration  Int?     @map("duracao")
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String @map("user_upload_id") @db.Uuid

  @@index([companyId])
  @@index([taskId])
  @@map("audios_tarefas")
}

model TaskVideo {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  duration  Int?     @map("duracao")
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String @map("user_upload_id") @db.Uuid

  @@index([companyId])
  @@index([taskId])
  @@map("videos_tarefas")
}

model Route {
  id          String      @id @default(uuid()) @map("id") @db.Uuid
  status      RouteStatus @default(SCHEDULED) @map("status")
  title       String      @map("titulo") @db.VarChar(200)
  description String?     @map("descricao") @db.Text
  routeDate   DateTime?   @map("data_rota")

  assignedTo   User?   @relation("RouteAssignedUser", fields: [assignedToId], references: [id])
  assignedToId String? @map("user_assigned_id") @db.Uuid

  createdBy   User     @relation("RouteCreatedBy", fields: [createdById], references: [id])
  createdById String   @map("user_create_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("criado_em")

  updatedBy   User?    @relation("RouteUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?  @map("user_update_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  tasks     Task[]
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, routeDate])
  @@index([assignedToId, status])
  @@map("rotas")
}

model Notification {
  id         String                  @id @default(uuid()) @map("id") @db.Uuid
  title      String                  @map("titulo") @db.VarChar(200)
  message    String                  @map("mensagem") @db.Text
  type       NotificationType        @map("tipo")
  isRead     Boolean                 @default(false) @map("lida")
  createdAt  DateTime                @default(now()) @map("criado_em")
  readAt     DateTime?               @map("lido_em")
  sourceType NotificationSourceType? @map("origem_tipo")
  sourceId   String?                 @map("origem_id") @db.Uuid

  users     UserNotification[]
  companyId String             @map("empresa_id") @db.Uuid
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String?            @map("tarefa_id") @db.Uuid
  task      Task?              @relation(fields: [taskId], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@index([isRead])
  @@map("notificacoes")
}

model UserNotification {
  isRead    Boolean   @default(false) @map("lida")
  readAt    DateTime? @map("lido_em")
  createdAt DateTime  @default(now()) @map("criado_em")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String       @map("usuario_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String       @map("notificacao_id") @db.Uuid

  @@id([userId, notificationId])
  @@index([createdAt])
  @@map("notificacoes_usuario")
}

model Material {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  description     String   @map("descricao") @db.VarChar(200)
  type            String   @map("tipo") @db.VarChar(50)
  month           String?  @map("mes") @db.VarChar(10)
  supplier        String?  @map("fornecedor") @db.VarChar(100)
  unitPrice       Decimal? @map("valor_unitario") @db.Decimal(10, 4)
  unitOfMeasure   String?  @map("unidade_medida") @db.VarChar(20)
  quantityPerUnit Float?   @map("quantidade_por_unidade")
  pricePerKg      Decimal? @map("valor_por_kg") @db.Decimal(10, 4)
  pricePerMeter   Decimal? @map("valor_por_metro") @db.Decimal(10, 4)
  color           String?  @map("cor") @db.VarChar(50)
  fabricUnit      String?  @map("unidade_tecido") @db.VarChar(20)
  yield           String?  @map("rendimento") @db.VarChar(50)
  weightPerMeter  String?  @map("peso_mt") @db.VarChar(50)
  sku             String?  @map("sku") @db.VarChar(50)
  minStock        Decimal? @default(0) @map("estoque_minimo") @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("ativo")
  createdAt       DateTime @default(now()) @map("criado_em")
  updatedAt       DateTime @updatedAt @map("atualizado_em")

  companyId String            @map("empresa_id") @db.Uuid
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  ProductMaterial[]

  @@index([companyId])
  @@index([type])
  @@index([supplier])
  @@index([month])
  @@index([description])
  @@index([sku])
  @@index([isActive])
  @@map("materiais")
}

model Product {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  ref          String   @unique @map("referencia") @db.VarChar(50)
  name         String   @map("nome") @db.VarChar(150)
  description  String?  @map("descricao") @db.Text
  baseCost     Decimal  @map("custo_base") @db.Decimal(10, 2)
  sellingPrice Decimal  @map("preco_venda") @db.Decimal(10, 2)
  sizeRange    String?  @map("faixa_tamanhos") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("ativo")
  createdAt    DateTime @default(now()) @map("criado_em")
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  companyId   String            @map("empresa_id") @db.Uuid
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials   ProductMaterial[]
  collections Collection[]

  @@index([companyId])
  @@index([ref])
  @@index([isActive])
  @@map("produtos")
}

model ProductMaterial {
  productId      String   @map("produto_id") @db.Uuid
  materialId     String   @map("material_id") @db.Uuid
  quantidade     Decimal  @map("quantidade") @db.Decimal(10, 4)
  tipoQuantidade String   @map("tipo_quantidade") @db.VarChar(20)
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(10, 4)
  custoUnitario  Decimal  @map("custo_unitario") @db.Decimal(10, 4)
  createdAt      DateTime @default(now()) @map("criado_em")
  updatedAt      DateTime @updatedAt @map("atualizado_em")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([productId, materialId])
  @@index([productId])
  @@index([materialId])
  @@index([tipoQuantidade])
  @@map("produtos_materiais")
}

model Budget {
  id               String       @id @default(uuid()) @map("id") @db.Uuid
  title            String       @map("titulo") @db.VarChar(200)
  clientName       String?      @map("nome_cliente") @db.VarChar(150)
  clientEmail      String?      @map("email_cliente") @db.VarChar(255)
  clientPhone      String?      @map("telefone_cliente") @db.VarChar(20)
  total            Decimal      @map("total") @db.Decimal(12, 2)
  status           BudgetStatus @default(PENDING) @map("status")
  items            Json?        @map("itens")
  validity         DateTime?    @map("validade")
  notes            String?      @map("observacoes") @db.Text
  service          String?      @map("servico") @db.VarChar(200)
  unitPrice        Decimal?     @map("valor_unitario") @db.Decimal(12, 2)
  paymentMethod    String?      @map("forma_pagamento") @db.VarChar(50)
  deliveryEstimate DateTime?    @map("previsao_entrega")
  quantity         Int?         @map("quantidade")
  approvedAt       DateTime?    @map("aprovado_em")
  rejectedAt       DateTime?    @map("rejeitado_em")
  createdAt        DateTime     @default(now()) @map("criado_em")
  updatedAt        DateTime     @updatedAt @map("atualizado_em")

  companyId    String  @map("empresa_id") @db.Uuid
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById  String  @map("criado_por_id") @db.Uuid
  createdBy    User    @relation("CreatedBudgets", fields: [createdById], references: [id])
  assignedToId String? @map("atribuido_para_id") @db.Uuid
  assignedTo   User?   @relation("AssignedBudgets", fields: [assignedToId], references: [id])
  taskId       String? @map("tarefa_id") @db.Uuid
  task         Task?   @relation(fields: [taskId], references: [id])

  @@index([companyId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([clientName])
  @@index([taskId])
  @@index([createdAt])
  @@index([validity])
  @@map("orcamentos")
}

model Collection {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  name        String   @map("nome") @db.VarChar(100)
  reference   String   @unique @map("referencia") @db.VarChar(50)
  model       String   @map("modelo") @db.VarChar(150)
  cutQuantity Int      @map("quantidade_cortada")
  totalCost   Decimal  @map("custo_total") @db.Decimal(10, 2)
  launch      Boolean  @default(false) @map("lancamento")
  color       String   @map("cor") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("criado_em")
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  companyId String   @map("empresa_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String?  @map("produto_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([name])
  @@index([reference])
  @@index([launch])
  @@index([createdAt])
  @@map("colecoes")
}

model Chat {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  companyId String?  @map("empresa_id") @db.Uuid
  createdAt DateTime @default(now()) @map("criado_em")

  company  Company?      @relation(fields: [companyId], references: [id])
  messages ChatMessage[]

  @@index([companyId])
  @@map("chats")
}

model ChatMessage {
  id                      String   @id @default(uuid()) @map("id") @db.Uuid
  chatId                  String?  @map("chat_id") @db.Uuid
  senderId                String   @map("remetente_id") @db.Uuid
  message                 String   @map("mensagem") @db.Text
  mentionedProfessionalId String?  @map("profissional_mencionado_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("criado_em")

  sender                User  @relation("UserSentMessages", fields: [senderId], references: [id])
  chat                  Chat? @relation(fields: [chatId], references: [id])
  mentionedProfessional User? @relation("MentionedProfessional", fields: [mentionedProfessionalId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@index([mentionedProfessionalId])
  @@index([createdAt])
  @@map("mensagens_chat")
}

