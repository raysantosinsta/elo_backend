  // Relacionamentos Reversos
  items      FlowItem[]
  itemStages FlowItemStage[] // NOVO: Relacionamento com a tabela item_stage

  @@unique([flowId, order], name: "fluxo_ordem_unica")
  @@index([flowId])
  @@map("etapas_fluxo")
}

// NOVA TABELA: Prazo real de cada item por etapa
model FlowItemStage {
  id String @id @default(uuid()) @map("id") @db.Uuid

  // Campo obrigatÃ³rio (prazo calculado)
  deadline DateTime @map("prazo")

  // Status da etapa
  status String @default("PENDENTE") @map("status")

  // Ordem da etapa (cache para consultas)
  order Int @map("ordem")

  // Datas sugeridas vs reais (OPCIONAIS)
  suggestedDeadline DateTime? @map("prazo_sugerido")
  actualDeadline    DateTime? @map("prazo_real")

  // ðŸ”¥ NOVO: Guardar referÃªncia ao prazo sugerido original da etapa
  basedOnSuggestedDeadline Int? @map("baseado_em_prazo_sugerido")

  // Metadados
  notes String? @map("observacoes") @db.Text

  // Controle de alteraÃ§Ãµes
  changedAt DateTime @default(now()) @map("alterado_em")
  changedBy String?  @map("alterado_por") @db.Uuid

  // Relacionamento com Item
  itemId String   @map("item_id") @db.Uuid
  item   FlowItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Relacionamento com Stage
  stageId String    @map("etapa_id") @db.Uuid
  stage   FlowStage @relation(fields: [stageId], references: [id])

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  // Ãndices
  @@unique([itemId, stageId])
  @@index([itemId])
  @@index([stageId])
  @@index([companyId])
  @@index([deadline])
  @@index([status])
  @@index([order])
  @@map("itens_etapas_prazo")
}

