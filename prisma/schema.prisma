// 1. FLUXO DE PRODUÇÃO (Esteira)
model ProductFlow {
  id       String    @id @default(uuid()) @map("id") @db.Uuid
  name     String    @map("nome") @db.VarChar(100)
  color    String?   @default("#D35400") @map("cor") @db.VarChar(7)
  deadline DateTime? @map("prazo")

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyProductFlows", fields: [companyId], references: [id]) // Consolidado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos Reversos
  stages FlowStage[]
  items  FlowItem[]

  @@index([companyId])
  @@map("fluxos_produto")
}

// 2. ETAPAS (Colunas personalizadas)
model FlowStage {
  id    String  @id @default(uuid()) @map("id") @db.Uuid
  name  String  @map("nome") @db.VarChar(50)
  order Int     @default(0) @map("ordem")
  color String? @map("cor") @db.VarChar(7)

  // 🔥 NOVO CAMPO: Dias padrão para conclusão da etapa
  defaultDays Int? @default(1) @map("dias_padrao")

  // // NOVO CAMPO: Prazo sugerido em dias (template)
  // suggestedDeadline Int? @default(0) @map("prazo_sugerido_dias")

  allowedRole String? @map("cargo_permitido") @db.VarChar(100)

  // Relacionamento com Fluxo
  flowId String      @map("fluxo_id") @db.Uuid
  flow   ProductFlow @relation(fields: [flowId], references: [id])

  // Relacionamento com Empresa (Opcional, se a etapa puder ser global ou precisar de referência direta)
  companyId String?  @db.Uuid
  company   Company? @relation("CompanyFlowStages", fields: [companyId], references: [id]) // Consolidado

  // Relacionamentos Reversos
  items      FlowItem[]
  itemStages FlowItemStage[] // NOVO: Relacionamento com a tabela item_stage

  @@unique([flowId, order], name: "fluxo_ordem_unica")
  @@index([flowId])
  @@map("etapas_fluxo")
}

// NOVA TABELA: Prazo real de cada item por etapa
model FlowItemStage {
  id String @id @default(uuid()) @map("id") @db.Uuid

  // Campo obrigatório (prazo calculado)
  deadline DateTime @map("prazo")

  // Status da etapa
  status String @default("PENDENTE") @map("status")

  // Ordem da etapa (cache para consultas)
  order Int @map("ordem")

  // Datas sugeridas vs reais (OPCIONAIS)
  suggestedDeadline DateTime? @map("prazo_sugerido")
  actualDeadline    DateTime? @map("prazo_real")

  // 🔥 NOVO: Guardar referência ao prazo sugerido original da etapa
  basedOnSuggestedDeadline Int? @map("baseado_em_prazo_sugerido")

  // Metadados
  notes String? @map("observacoes") @db.Text

  // Controle de alterações
  changedAt DateTime @default(now()) @map("alterado_em")
  changedBy String?  @map("alterado_por") @db.Uuid

  // Relacionamento com Item
  itemId String   @map("item_id") @db.Uuid
  item   FlowItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Relacionamento com Stage
  stageId String    @map("etapa_id") @db.Uuid
  stage   FlowStage @relation(fields: [stageId], references: [id])

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  // Índices
  @@unique([itemId, stageId])
  @@index([itemId])
  @@index([stageId])
  @@index([companyId])
  @@index([deadline])
  @@index([status])
  @@index([order])
  @@map("itens_etapas_prazo")
}

// 3. ITENS NO FLUXO
model FlowItem {
  id          String @id @default(uuid()) @map("id") @db.Uuid
  title       String @map("titulo") @db.VarChar(200)
  orderNumber String @map("numero_pedido") @db.VarChar(50)
  status      String @default("PENDENTE") @map("status") // Verifique se este campo existe aqui!

  // Posição
  stageId      String?    @map("etapa_id") @db.Uuid
  stage        FlowStage? @relation(fields: [stageId], references: [id])
  orderInStage Int        @default(0) @map("ordem_etapa")

  // Dados
  productRef  String  @map("ref_produto") @db.VarChar(50)
  quantity    Int     @default(1) @map("quantidade")
  priority    Int     @default(3) @map("prioridade")
  description String? @map("descricao") @db.Text

  // Fluxo
  flowId String      @map("fluxo_id") @db.Uuid
  flow   ProductFlow @relation(fields: [flowId], references: [id])

  // Novo Campo de Relacionamento
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?   @map("fornecedor_id") @db.Uuid

  // Datas
  dueDate             DateTime? @map("prazo")
  enteredAt           DateTime  @default(now()) @map("entrada_em")
  productionStartedAt DateTime? @map("data_do_inicio_da_producao")
  deliveryAt          DateTime? @map("data_de_entrega_da_producao")

  // Responsável
  assignedToId String? @map("responsavel_id") @db.Uuid
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  // Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyFlowItems", fields: [companyId], references: [id]) // Consolidado

  // NOVO RELACIONAMENTO: ItensStage
  itemStages FlowItemStage[] // Todos os prazos por etapa

  // Relacionamentos com mídias
  images FlowImage[]
  audios FlowAudio[]
  videos FlowVideo[]

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  @@index([companyId])
  @@index([flowId])
  @@index([stageId])
  @@index([assignedToId])
  @@index([priority])
  @@index([dueDate])
  @@map("itens_fluxo")
}

model FlowTemplate {
  id        String @id @default(uuid()) @map("id") @db.Uuid
  name      String @map("nome") @db.VarChar(150)
  structure Json   @map("estrutura") // [{ "name": "Corte", "color": "#2C3E50" }, ...]

  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyFlowTemplates", fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  @@index([companyId])
  @@map("templates_fluxo")
}

