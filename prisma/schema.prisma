generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
// Removida CompanyStatus por ser idÃªntica a SimpleStatus
enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  EXPIRED
}

enum BillingAccountStatus {
  TRIAL_ACTIVE
  TRIAL_EXPIRED
  ACTIVE
  OVERDUE
  BLOCKED
  CANCELED
}

enum BillingSubscriptionStatus {
  PENDING
  ACTIVE
  OVERDUE
  CANCELED
  EXPIRED
}

enum BillingPaymentStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  REFUNDED
  CHARGEBACK
  CANCELED
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATED
  FAILED
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum PartnerCommissionStatus {
  PENDING
  AVAILABLE
  BLOCKED
  PAID
  CANCELED
  REVERSED
}

enum PartnerWithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CANCELED
}

enum PlanPeriod {
  MONTHLY
  YEARLY
}

enum NotificationSourceType {
  SYSTEM
  TASK
  ROUTE
}

enum RouteStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum UserRole {
  MASTER
  ADMIN
  EMPLOYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  RESCHEDULED
}

enum BudgetGroupStatus {
  PENDING
  ANSWERED
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SimpleStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  BUDGET_APPROVED
  BUDGET_PENDING_APPROVAL
  BUDGET_REJECTED
  SYSTEM_ALERT
  PAYMENT_REMINDER
  TASK_OVERDUE
  NEW_MESSAGE
  COLLECTION_LAUNCHED
  LOW_STOCK_ALERT
}

enum KanbanColumnStatus {
  ACTIVE
  ARCHIVED
}

// Models
model Company {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status SimpleStatus @default(ACTIVE) @map("status")

  name          String  @map("nome") @db.VarChar(150)
  cnpj          String  @unique @map("cnpj") @db.VarChar(18)
  telefone      String  @map("telefone") @db.VarChar(20)
  email         String  @map("email") @db.VarChar(255)
  endereco      String  @map("endereco") @db.VarChar(300)
  numero        String  @map("numero") @db.VarChar(10)
  complemento   String? @map("complemento") @db.VarChar(100)
  bairro        String  @map("bairro") @db.VarChar(100)
  cidade        String  @map("cidade") @db.VarChar(100)
  estado        String  @map("estado") @db.VarChar(2)
  cep           String  @map("cep") @db.VarChar(9)
  ramoAtividade String? @map("ramo_atividade") @db.VarChar(100)

  notificationDays Int @default(7) @map("dias_antecedencia_notificacao")

  billingStatus        BillingAccountStatus @default(TRIAL_ACTIVE) @map("status_financeiro")
  trialStart           DateTime?            @map("inicio_teste")
  trialEnd             DateTime?            @map("fim_teste")
  asaasCustomerId      String?              @unique @map("asaas_customer_id") @db.VarChar(120)
  referredByPartnerId  String?              @map("parceiro_indicador_id") @db.Uuid
  referredByPartner    Partner?             @relation("PartnerReferredCompanies", fields: [referredByPartnerId], references: [id])

  // Controle de CriaÃ§Ã£o/AtualizaÃ§Ã£o
  userCreate   User?    @relation("CompanyCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String?  @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("data_de_criacao")

  userUpdate   User?    @relation("CompanyUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  users              User[]              @relation("CompanyMembers")
  kanbanCols         KanbanColumn[]      @relation("CompanyKanbanColumns") // Mantido um nome de relaÃ§Ã£o para KanbanColumn[]
  tasks              Task[]              @relation("CompanyTasks")
  notifications      Notification[]      @relation("CompanyNotifications")
  materials          Material[]          @relation("CompanyMaterials")
  products           Product[]           @relation("CompanyProducts")
  budgets            Budget[]            @relation("CompanyBudgets")
  routes             Route[]             @relation("CompanyRoutes")
  taskImages         TaskImage[]         @relation("CompanyTaskImages")
  taskAudios         TaskAudio[]         @relation("CompanyTaskAudios")
  taskVideos         TaskVideo[]         @relation("CompanyTaskVideos")
  taskAddresses      TaskAddress[]       @relation("CompanyTaskAddresses")
  chats              Chat[]              @relation("CompanyChats")
  productFlows       ProductFlow[]       @relation("CompanyProductFlows")
  flowStages         FlowStage[]         @relation("CompanyFlowStages")
  flowItems          FlowItem[]          @relation("CompanyFlowItems")
  flowImages         FlowImage[]         @relation("CompanyFlowImages")
  flowAudios         FlowAudio[]         @relation("CompanyFlowAudios")
  flowVideos         FlowVideo[]         @relation("CompanyFlowVideos")
  flowTemplates      FlowTemplate[]      @relation("CompanyFlowTemplates")
  suppliers          Supplier[]
  budgetGroups       BudgetGroup[]
  routeStops         RouteStop[]
  whatsappConnection WhatsAppConnection? // Uma empresa pode ter UMA conexÃ£o WhatsApp (opcional)

  auditLogs    AuditLog[]
  itemStages   FlowItemStage[] // ou flowItemStages, mas nÃ£o ambos
  companyRoles CompanyRole[]
  subscriptions BillingSubscription[]
  payments      BillingPayment[]
  webhookEvents AsaasWebhookEvent[]
  partnerProfile Partner?
  partnerCommissions PartnerCommission[]
  partnerWithdrawals PartnerWithdrawal[]

  @@index([cnpj])
  @@index([status])
  @@index([billingStatus])
  @@index([trialEnd])
  @@index([referredByPartnerId])
  @@index([createdAt])
  @@map("empresas")
}

// Adicione este modelo APÃ“S o model Company no seu schema.prisma

model WhatsAppConnection {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @unique @map("company_id") @db.Uuid
  instanceId Int? // ID da instÃ¢ncia na API do AtendePro
  name       String   @map("name") @db.VarChar(100)
  token      String   @map("token") @db.Text
  status     String   @default("connected") @map("status")
  qrCode     String?  @map("qr_code") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("whatsapp_connections")
}

model User {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status SimpleStatus @default(ACTIVE) @map("status")
  role   UserRole     @map("perfil")

  name     String  @map("nome") @db.VarChar(150)
  email    String  @unique @map("email") @db.VarChar(255)
  document String? @unique @map("documento") @db.VarChar(20)
  contact  String  @map("contato") @db.VarChar(20)
  password String  @map("senha") @db.VarChar(255)

  professionalRoleId String?      @map("cargo_profissional_id") @db.Uuid
  professionalRole   CompanyRole? @relation("UserProfessionalRole", fields: [professionalRoleId], references: [id])

  // ðŸ”¥ NOVO CAMPO: Armazenar o nome do cargo profissional
  professionalRoleName String? @map("cargo_profissional_nome") @db.VarChar(100)

  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  // --- NOVOS CAMPOS: Auditoria de UsuÃ¡rios (Self-Relation) ---
  userCreateId String? @map("user_create_id") @db.Uuid
  userCreate   User?   @relation("UserCreatedBy", fields: [userCreateId], references: [id])

  userUpdateId String? @map("user_update_id") @db.Uuid
  userUpdate   User?   @relation("UserUpdatedBy", fields: [userUpdateId], references: [id])

  // Relacionamentos Reversos (UsuÃ¡rios criados/editados por este usuÃ¡rio)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  // -----------------------------------------------------------

  // Relacionamento com Empresa
  company   Company? @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?  @map("empresa_id") @db.Uuid

  // Relacionamentos Reversos
  createdCompanys Company[] @relation("CompanyCreatedBy")
  updatedCompanys Company[] @relation("CompanyUpdatedBy")

  createdKanbanColumn KanbanColumn[] @relation("KanbanColumnCreatedBy")
  updatedKanbanColumn KanbanColumn[] @relation("KanbanColumnUpdatedBy")

  createdTasks   Task[] @relation("TaskCreatedBy")
  updatedTasks   Task[] @relation("TaskUpdatedBy")
  completedTasks Task[] @relation("TaskCompletedUser")
  assignedTasks  Task[] @relation("TaskAssignedUser")

  uploadedImagesTask TaskImage[]
  uploadedAudiosTask TaskAudio[]
  uploadedVideosTask TaskVideo[]

  createdRoutes  Route[] @relation("RouteCreatedBy")
  updatedRoutes  Route[] @relation("RouteUpdatedBy")
  assignedRoutes Route[] @relation("RouteAssignedUser")

  notifications UserNotification[]
  partnerProfile Partner? @relation("PartnerUser")
  approvedPartners Partner[] @relation("PartnerApprovedBy")
  reviewedWithdrawals PartnerWithdrawal[] @relation("WithdrawalReviewedBy")

  createdSuppliers         Supplier[]         @relation("SupplierCreatedBy")
  updatedSuppliers         Supplier[]         @relation("SupplierUpdatedBy")
  createdMaterials         Material[]         @relation("MaterialCreatedBy")
  updatedMaterials         Material[]         @relation("MaterialUpdatedBy")
  createdSupplierMaterials SupplierMaterial[] @relation("SupplierMaterialCreatedBy")
  updatedSupplierMaterials SupplierMaterial[] @relation("SupplierMaterialUpdatedBy")
  createdProducts          Product[]          @relation("ProductCreatedBy")
  updatedProducts          Product[]          @relation("ProductUpdatedBy")
  createdProductMaterials  ProductMaterial[]  @relation("ProductMaterialCreatedBy")
  updatedProductMaterials  ProductMaterial[]  @relation("ProductMaterialUpdatedBy")

  createdBudgets       Budget[]      @relation("BudgetCreatedBy")
  updatedBudgets       Budget[]      @relation("BudgetUpdatedBy")
  assignedBudgets      Budget[]      @relation("BudgetAssignedTo")
  createdBudgetGroups  BudgetGroup[] @relation("BudgetGroupCreatedBy")
  assignedBudgetGroups BudgetGroup[] @relation("BudgetGroupAssignedTo")

  sentMessages        ChatMessage[] @relation("UserSentMessages")
  mentionedInMessages ChatMessage[] @relation("MentionedProfessional")

  flowItems  FlowItem[]
  flowImages FlowImage[]
  flowAudios FlowAudio[]
  flowVideos FlowVideo[]

  auditLogs           AuditLog[]
  createdCompanyRoles CompanyRole[] @relation("CompanyRoleCreatedBy")
  updatedCompanyRoles CompanyRole[] @relation("CompanyRoleUpdatedBy")

  // ðŸ”¥ APENAS ESTA DECLARAÃ‡ÃƒO (mantenha esta e remova a outra no final)
  companyRoleId String?      @map("cargo_empresa_id") @db.Uuid
  companyRole   CompanyRole? @relation("UserCompanyRole", fields: [companyRoleId], references: [id])

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("usuarios")
}

model CompanyRole {
  id          String       @id @default(uuid()) @map("id") @db.Uuid
  status      SimpleStatus @default(ACTIVE) @map("status")
  name        String       @map("nome") @db.VarChar(100)
  description String?      @map("descricao") @db.Text
  level       Int          @default(1) @map("nivel") // Para ordenaÃ§Ã£o/hierarquia

  // Relacionamento com Empresa (MULTI-TENANT)
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Controle de CriaÃ§Ã£o/AtualizaÃ§Ã£o
  userCreateId String?  @map("user_create_id") @db.Uuid
  userCreate   User?    @relation("CompanyRoleCreatedBy", fields: [userCreateId], references: [id])
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdateId String?  @map("user_update_id") @db.Uuid
  userUpdate   User?    @relation("CompanyRoleUpdatedBy", fields: [userUpdateId], references: [id])
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // ðŸ”¥ RELACIONAMENTO 1: UsuÃ¡rios que tÃªm este cargo como "professionalRole"
  professionalRoleUsers User[] @relation("UserProfessionalRole")

  // ðŸ”¥ RELACIONAMENTO 2: UsuÃ¡rios que tÃªm este cargo como "companyRole"
  companyRoleUsers User[] @relation("UserCompanyRole")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
  @@index([level])
  @@map("cargos_empresa")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model KanbanColumn {
  id     String             @id @default(uuid()) @map("id") @db.Uuid
  status KanbanColumnStatus @default(ACTIVE)
  order  Int                @default(0) @map("ordem")

  title       String @map("titulo") @db.Text
  description String @map("descricao") @db.Text

  tasks Task[]

  // Relacionamento com Empresa
  companyId String?  @map("empresa_id") @db.Uuid
  company   Company? @relation("CompanyKanbanColumns", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Controle de CriaÃ§Ã£o/AtualizaÃ§Ã£o
  userCreate   User     @relation("KanbanColumnCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("KanbanColumnUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  @@unique([companyId, title], name: "empresa_titulo")
  @@index([companyId])
  @@index([order])
  @@map("colunas_kanban")
}

model Task {
  id     String     @id @default(uuid()) @map("id") @db.Uuid
  status TaskStatus @default(PENDING) @map("status")

  title        String  @map("titulo") @db.VarChar(200)
  description  String? @map("descricao") @db.Text
  finalComment String? @map("comentario_final") @db.Text

  scheduledDate  DateTime? @map("agendado_para")
  dueDate        DateTime? @map("prazo")
  completionDate DateTime? @map("data_conclusao")

  priority    Int @default(1) @map("prioridade")
  columnOrder Int @default(0) @map("ordem_coluna") //ordem dentro da coluna

  intervalTime Int? @map("tempo_intervalo") // Tempo gasto na tarefa, em minutos

  // UsuÃ¡rios Relacionados
  userAssigned   User?   @relation("TaskAssignedUser", fields: [userAssignedId], references: [id])
  userAssignedId String? @map("user_assigned_id") @db.Uuid

  userCompleted   User?   @relation("TaskCompletedUser", fields: [userCompletedId], references: [id])
  userCompletedId String? @map("user_completed_id") @db.Uuid

  // Kanban
  columnId String       @map("coluna_id") @db.Uuid
  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  // Rota
  routeId String? @map("rota_id") @db.Uuid
  route   Route?  @relation(fields: [routeId], references: [id])

  // ðŸ”¥ NOVO RELACIONAMENTO COM ROUTESTOP
  routeStops RouteStop[] // <--- ADICIONE ESTA LINHA

  // Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTasks", fields: [companyId], references: [id], onDelete: Cascade)

  // Controle de CriaÃ§Ã£o/AtualizaÃ§Ã£o
  userCreate   User     @relation("TaskCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("TaskUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  notifications Notification[]
  budgets       Budget[]       @relation("TaskAssociation")
  taskImages    TaskImage[]
  taskAudios    TaskAudio[]
  taskVideos    TaskVideo[]
  taskAddress   TaskAddress?

  budgetId String? @db.Uuid
  budget   Budget? @relation(fields: [budgetId], references: [id])

  @@index([companyId])
  @@index([userAssignedId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([dueDate, status])
  @@index([userAssignedId, status])
  @@index([routeId])
  @@map("tarefas")
}

model TaskAddress {
  id String @id @default(uuid()) @map("id") @db.Uuid

  cep         String  @map("cep") @db.VarChar(8)
  endereco    String  @map("endereco") @db.VarChar(200)
  numero      String  @map("numero") @db.VarChar(10)
  bairro      String  @map("bairro") @db.VarChar(100)
  cidade      String  @map("cidade") @db.VarChar(100)
  estado      String  @map("estado") @db.VarChar(2)
  complemento String? @map("complemento") @db.VarChar(100)

  latitude  Float? @map("latitude")
  longitude Float? @map("longitude")

  // Relacionamento com Task
  taskId String @unique @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskAddresses", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([taskId])
  @@map("enderecos_tarefas")
}

model TaskImage {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  // Relacionamento com Task
  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com UsuÃ¡rio de Upload
  userUploadedId String @map("user_upload_id") @db.Uuid
  userUploaded   User   @relation(fields: [userUploadedId], references: [id])

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskImages", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([taskId])
  @@map("imagens_tarefas")
}

model TaskAudio {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  duration  Int?     @map("duracao")
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  // Relacionamento com Task
  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com UsuÃ¡rio de Upload
  userUploadedId String @map("user_upload_id") @db.Uuid
  userUploaded   User   @relation(fields: [userUploadedId], references: [id])

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskAudios", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([taskId])
  @@map("audios_tarefas")
}

model TaskVideo {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  duration  Int?     @map("duracao")
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  // Relacionamento com Task
  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskVideos", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Relacionamento com UsuÃ¡rio de Upload
  userUploadedId String @map("user_upload_id") @db.Uuid
  userUploaded   User   @relation(fields: [userUploadedId], references: [id])

  @@index([companyId])
  @@index([taskId])
  @@map("videos_tarefas")
}

model Route {
  id          String      @id @default(uuid()) @map("id") @db.Uuid
  status      RouteStatus @default(SCHEDULED) @map("status")
  title       String      @map("titulo") @db.VarChar(200)
  description String?     @map("descricao") @db.Text
  routeDate   DateTime?   @map("data_rota")
  orderBy     String?     @default("DISTANCE") @map("tipo_ordenacao")

  // NOVOS CAMPOS
  totalDistanceMeters  Float?    @map("distancia_total_metros")
  totalDurationSeconds Int?      @map("duracao_total_segundos")
  optimizedAt          DateTime? @map("otimizado_em")

  fuelConsumptionLitres Float? @map("consumo_combustivel_litros") // em litros
  // NOVO: Consumo de combustÃ­vel previsto (litros)
  estimatedFuel Float? @map("combustivel_previsto")

  // ROTA REALIZADA (executada)
  actualDistance Float?   @map("distancia_real")      // Km de fato rodados
  actualTime     Int?     @map("tempo_real")          // Minutos de fato levou
  actualFuel     Float?   @map("combustivel_real")    // Litros de fato consumidos
  startedAt      DateTime? @map("iniciado_em")
  completedAt    DateTime? @map("finalizado_em")


  // NOVO RELACIONAMENTO
  stops RouteStop[]

  // UsuÃ¡rio AtribuÃ­do
  userAssigned   User?   @relation("RouteAssignedUser", fields: [userAssignedId], references: [id])
  userAssignedId String? @map("user_assigned_id") @db.Uuid

  tasks Task[]

  // Controle de CriaÃ§Ã£o/AtualizaÃ§Ã£o
  userCreate   User     @relation("RouteCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("RouteUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyRoutes", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, routeDate])
  @@index([userAssignedId, status])
  @@map("rotas")
}

// NOVO MODEL
model RouteStop {
  id String @id @default(uuid()) @map("id") @db.Uuid

  // ðŸ”¥ NOVO CAMPO: ReferÃªncia Ã  tarefa
  taskId String? @map("task_id") @db.Uuid
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Dados da parada
  name         String? @map("nome") @db.VarChar(200)
  address      String  @map("endereco") @db.VarChar(300)
  complement   String? @map("complemento") @db.VarChar(100)
  neighborhood String? @map("bairro") @db.VarChar(100)
  city         String  @map("cidade") @db.VarChar(100)
  state        String  @map("estado") @db.VarChar(2)
  zipCode      String  @map("cep") @db.VarChar(9)

  // Coordenadas
  latitude  Float @map("latitude")
  longitude Float @map("longitude")

  // Ordem na rota
