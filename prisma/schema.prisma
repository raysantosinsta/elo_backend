generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
// Removida CompanyStatus por ser idêntica a SimpleStatus
enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  EXPIRED
}

enum PlanPeriod {
  MONTHLY
  YEARLY
}

enum NotificationSourceType {
  SYSTEM
  TASK
  ROUTE
}

enum RouteStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum UserRole {
  MASTER
  ADMIN
  EMPLOYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BudgetGroupStatus {
  PENDING
  ANSWERED
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SimpleStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  BUDGET_APPROVED
  BUDGET_PENDING_APPROVAL
  BUDGET_REJECTED
  SYSTEM_ALERT
  PAYMENT_REMINDER
  TASK_OVERDUE
  NEW_MESSAGE
  COLLECTION_LAUNCHED
  LOW_STOCK_ALERT
}

enum KanbanColumnStatus {
  ACTIVE
  ARCHIVED
}

// Models
model Company {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status SimpleStatus @default(ACTIVE) @map("status")

  name          String  @map("nome") @db.VarChar(150)
  cnpj          String  @unique @map("cnpj") @db.VarChar(18)
  telefone      String  @map("telefone") @db.VarChar(20)
  email         String  @map("email") @db.VarChar(255)
  endereco      String  @map("endereco") @db.VarChar(300)
  numero        String  @map("numero") @db.VarChar(10)
  complemento   String? @map("complemento") @db.VarChar(100)
  bairro        String  @map("bairro") @db.VarChar(100)
  cidade        String  @map("cidade") @db.VarChar(100)
  estado        String  @map("estado") @db.VarChar(2)
  cep           String  @map("cep") @db.VarChar(9)
  ramoAtividade String? @map("ramo_atividade") @db.VarChar(100)

   notificationDays Int @default(7) @map("dias_antecedencia_notificacao")

  // Controle de Criação/Atualização
  userCreate   User?    @relation("CompanyCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String?  @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("data_de_criacao")

  userUpdate   User?    @relation("CompanyUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  users         User[]         @relation("CompanyMembers")
  kanbanCols    KanbanColumn[] @relation("CompanyKanbanColumns") // Mantido um nome de relação para KanbanColumn[]
  tasks         Task[]         @relation("CompanyTasks")
  notifications Notification[] @relation("CompanyNotifications")
  materials     Material[]     @relation("CompanyMaterials")
  products      Product[]      @relation("CompanyProducts")
  budgets       Budget[]       @relation("CompanyBudgets")
  routes        Route[]        @relation("CompanyRoutes")
  taskImages    TaskImage[]    @relation("CompanyTaskImages")
  taskAudios    TaskAudio[]    @relation("CompanyTaskAudios")
  taskVideos    TaskVideo[]    @relation("CompanyTaskVideos")
  taskAddresses TaskAddress[]  @relation("CompanyTaskAddresses")
  chats         Chat[]         @relation("CompanyChats")
  productFlows  ProductFlow[]  @relation("CompanyProductFlows")
  flowStages    FlowStage[]    @relation("CompanyFlowStages")
  flowItems     FlowItem[]     @relation("CompanyFlowItems")
  flowImages    FlowImage[]    @relation("CompanyFlowImages")
  flowAudios    FlowAudio[]    @relation("CompanyFlowAudios")
  flowVideos    FlowVideo[]    @relation("CompanyFlowVideos")
  flowTemplates FlowTemplate[] @relation("CompanyFlowTemplates")
  suppliers     Supplier[]
  budgetGroups  BudgetGroup[]
  routeStops RouteStop[]

  auditLogs  AuditLog[]
  itemStages FlowItemStage[] // ou flowItemStages, mas não ambos

  @@index([cnpj])
  @@index([status])
  @@index([createdAt])
  @@map("empresas")
}

model User {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status SimpleStatus @default(ACTIVE) @map("status")
  role   UserRole     @map("perfil")

  name     String  @map("nome") @db.VarChar(150)
  email    String  @unique @map("email") @db.VarChar(255)
  document String? @unique @map("documento") @db.VarChar(20)
  contact  String  @map("contato") @db.VarChar(20)
  password String  @map("senha") @db.VarChar(255)

  professionalRole String? @map("cargo_profissional") @db.VarChar(100)

  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  // --- NOVOS CAMPOS: Auditoria de Usuários (Self-Relation) ---
  userCreateId String? @map("user_create_id") @db.Uuid
  userCreate   User?   @relation("UserCreatedBy", fields: [userCreateId], references: [id])

  userUpdateId String? @map("user_update_id") @db.Uuid
  userUpdate   User?   @relation("UserUpdatedBy", fields: [userUpdateId], references: [id])

  // Relacionamentos Reversos (Usuários criados/editados por este usuário)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  // -----------------------------------------------------------

  // Relacionamento com Empresa
  company   Company? @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?  @map("empresa_id") @db.Uuid

  // Relacionamentos Reversos
  createdCompanys Company[] @relation("CompanyCreatedBy")
  updatedCompanys Company[] @relation("CompanyUpdatedBy")

  createdKanbanColumn KanbanColumn[] @relation("KanbanColumnCreatedBy")
  updatedKanbanColumn KanbanColumn[] @relation("KanbanColumnUpdatedBy")

  createdTasks   Task[] @relation("TaskCreatedBy")
  updatedTasks   Task[] @relation("TaskUpdatedBy")
  completedTasks Task[] @relation("TaskCompletedUser")
  assignedTasks  Task[] @relation("TaskAssignedUser")

  uploadedImagesTask TaskImage[]
  uploadedAudiosTask TaskAudio[]
  uploadedVideosTask TaskVideo[]

  createdRoutes  Route[] @relation("RouteCreatedBy")
  updatedRoutes  Route[] @relation("RouteUpdatedBy")
  assignedRoutes Route[] @relation("RouteAssignedUser")

  notifications UserNotification[]

  createdSuppliers         Supplier[]         @relation("SupplierCreatedBy")
  updatedSuppliers         Supplier[]         @relation("SupplierUpdatedBy")
  createdMaterials         Material[]         @relation("MaterialCreatedBy")
  updatedMaterials         Material[]         @relation("MaterialUpdatedBy")
  createdSupplierMaterials SupplierMaterial[] @relation("SupplierMaterialCreatedBy")
  updatedSupplierMaterials SupplierMaterial[] @relation("SupplierMaterialUpdatedBy")
  createdProducts          Product[]          @relation("ProductCreatedBy")
  updatedProducts          Product[]          @relation("ProductUpdatedBy")
  createdProductMaterials  ProductMaterial[]  @relation("ProductMaterialCreatedBy")
  updatedProductMaterials  ProductMaterial[]  @relation("ProductMaterialUpdatedBy")

  createdBudgets       Budget[]      @relation("BudgetCreatedBy")
  updatedBudgets       Budget[]      @relation("BudgetUpdatedBy")
  assignedBudgets      Budget[]      @relation("BudgetAssignedTo")
  createdBudgetGroups  BudgetGroup[] @relation("BudgetGroupCreatedBy")
  assignedBudgetGroups BudgetGroup[] @relation("BudgetGroupAssignedTo")

  sentMessages        ChatMessage[] @relation("UserSentMessages")
  mentionedInMessages ChatMessage[] @relation("MentionedProfessional")

  flowItems  FlowItem[]
  flowImages FlowImage[]
  flowAudios FlowAudio[]
  flowVideos FlowVideo[]

  auditLogs AuditLog[]

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("usuarios")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model KanbanColumn {
  id     String             @id @default(uuid()) @map("id") @db.Uuid
  status KanbanColumnStatus @default(ACTIVE)
  order  Int                @default(0) @map("ordem")

  title       String @map("titulo") @db.Text
  description String @map("descricao") @db.Text

  tasks Task[]

  // Relacionamento com Empresa
  companyId String?  @map("empresa_id") @db.Uuid
  company   Company? @relation("CompanyKanbanColumns", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Controle de Criação/Atualização
  userCreate   User     @relation("KanbanColumnCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("KanbanColumnUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  @@unique([companyId, title], name: "empresa_titulo")
  @@index([companyId])
  @@index([order])
  @@map("colunas_kanban")
}

model Task {
  id     String     @id @default(uuid()) @map("id") @db.Uuid
  status TaskStatus @default(PENDING) @map("status")

  title        String  @map("titulo") @db.VarChar(200)
  description  String? @map("descricao") @db.Text
  finalComment String? @map("comentario_final") @db.Text

  scheduledDate  DateTime? @map("agendado_para")
  dueDate        DateTime? @map("prazo")
  completionDate DateTime? @map("data_conclusao")

  priority    Int @default(1) @map("prioridade")
  columnOrder Int @default(0) @map("ordem_coluna") //ordem dentro da coluna

  // Usuários Relacionados
  userAssigned   User?   @relation("TaskAssignedUser", fields: [userAssignedId], references: [id])
  userAssignedId String? @map("user_assigned_id") @db.Uuid

  userCompleted   User?   @relation("TaskCompletedUser", fields: [userCompletedId], references: [id])
  userCompletedId String? @map("user_completed_id") @db.Uuid

  // Kanban
  columnId String       @map("coluna_id") @db.Uuid
  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  // Rota
  routeId String? @map("rota_id") @db.Uuid
  route   Route?  @relation(fields: [routeId], references: [id])

  // Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTasks", fields: [companyId], references: [id], onDelete: Cascade)

  // Controle de Criação/Atualização
  userCreate   User     @relation("TaskCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("TaskUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  notifications Notification[]
  budgets       Budget[]       @relation("TaskAssociation")
  taskImages    TaskImage[]
  taskAudios    TaskAudio[]
  taskVideos    TaskVideo[]
  taskAddress   TaskAddress?

  budgetId String? @db.Uuid
  budget   Budget? @relation(fields: [budgetId], references: [id])

  @@index([companyId])
  @@index([userAssignedId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([dueDate, status])
  @@index([userAssignedId, status])
  @@index([routeId])
  @@map("tarefas")
}

model TaskAddress {
  id String @id @default(uuid()) @map("id") @db.Uuid

  cep         String  @map("cep") @db.VarChar(8)
  endereco    String  @map("endereco") @db.VarChar(200)
  numero      String  @map("numero") @db.VarChar(10)
  bairro      String  @map("bairro") @db.VarChar(100)
  cidade      String  @map("cidade") @db.VarChar(100)
  estado      String  @map("estado") @db.VarChar(2)
  complemento String? @map("complemento") @db.VarChar(100)

  latitude  Float? @map("latitude")
  longitude Float? @map("longitude")

  // Relacionamento com Task
  taskId String @unique @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskAddresses", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([taskId])
  @@map("enderecos_tarefas")
}

model TaskImage {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  // Relacionamento com Task
  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com Usuário de Upload
  userUploadedId String @map("user_upload_id") @db.Uuid
  userUploaded   User   @relation(fields: [userUploadedId], references: [id])

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskImages", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([taskId])
  @@map("imagens_tarefas")
}

model TaskAudio {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  duration  Int?     @map("duracao")
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")

  // Relacionamento com Task
  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com Usuário de Upload
  userUploadedId String @map("user_upload_id") @db.Uuid
  userUploaded   User   @relation(fields: [userUploadedId], references: [id])

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskAudios", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([taskId])
  @@map("audios_tarefas")
}

model TaskVideo {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  url       String   @map("url") @db.VarChar(500)
  filename  String   @map("nome_arquivo") @db.VarChar(200)
  duration  Int?     @map("duracao")
  size      Int?     @map("tamanho")
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  // Relacionamento com Task
  taskId String @map("tarefa_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyTaskVideos", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Relacionamento com Usuário de Upload
  userUploadedId String @map("user_upload_id") @db.Uuid
  userUploaded   User   @relation(fields: [userUploadedId], references: [id])

  @@index([companyId])
  @@index([taskId])
  @@map("videos_tarefas")
}

model Route {
  id          String      @id @default(uuid()) @map("id") @db.Uuid
  status      RouteStatus @default(SCHEDULED) @map("status")
  title       String      @map("titulo") @db.VarChar(200)
  description String?     @map("descricao") @db.Text
  routeDate   DateTime?   @map("data_rota")
  orderBy String? @default("DISTANCE") @map("tipo_ordenacao")

   // NOVOS CAMPOS
  totalDistanceMeters Float?   @map("distancia_total_metros")
  totalDurationSeconds Int?    @map("duracao_total_segundos")
  optimizedAt         DateTime? @map("otimizado_em")

  // NOVO RELACIONAMENTO
  stops RouteStop[]

  // Usuário Atribuído
  userAssigned   User?   @relation("RouteAssignedUser", fields: [userAssignedId], references: [id])
  userAssignedId String? @map("user_assigned_id") @db.Uuid

  tasks Task[]

  // Controle de Criação/Atualização
  userCreate   User     @relation("RouteCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("RouteUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyRoutes", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, routeDate])
  @@index([userAssignedId, status])
  @@map("rotas")
}

// NOVO MODEL
model RouteStop {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  
  // Dados da parada
  name        String? @map("nome") @db.VarChar(200)
  address     String  @map("endereco") @db.VarChar(300)
  complement  String? @map("complemento") @db.VarChar(100)
  neighborhood String? @map("bairro") @db.VarChar(100)
  city        String  @map("cidade") @db.VarChar(100)
  state       String  @map("estado") @db.VarChar(2)
  zipCode     String  @map("cep") @db.VarChar(9)
  
  // Coordenadas
  latitude  Float @map("latitude")
  longitude Float @map("longitude")
  
  // Ordem na rota
  order     Int   @default(0) @map("ordem")
  
  // Metadados
  notes     String? @map("observacoes") @db.Text
  visitedAt DateTime? @map("visitado_em")
  visited   Boolean  @default(false) @map("visitado")
  
  // Relacionamentos
  routeId   String @map("rota_id") @db.Uuid
  route     Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")
  
  @@index([routeId])
  @@index([order])
  @@index([companyId])
  @@map("paradas_rota")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  title   String?
  message String?

  // Relacionamento com Empresa
  companyId String?  @db.Uuid
  company   Company? @relation("CompanyNotifications", fields: [companyId], references: [id], onDelete: Cascade)

  // Relacionamento com Task (Opcional)
  taskId String? @db.Uuid

  createdAt DateTime @default(now())

  // Relacionamento Reversos
  userNotifications UserNotification[]
  task              Task?              @relation(fields: [taskId], references: [id])

  @@map("notificacoes")
}

model UserNotification {
  isRead Boolean   @default(false) @map("lida")
  readAt DateTime? @map("lido_em")

  // Relacionamentos
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("usuario_id") @db.Uuid

  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String       @map("notificacao_id") @db.Uuid

  @@id([userId, notificationId])
  @@index([notificationId])
  @@map("notificacoes_usuario")
}

// 1. Enum para diferenciar quem vende tecido de quem costura
enum SupplierCategory {
  MATERIAL_ONLY // Só vende materiais
  SERVICE_ONLY // Só presta serviço (Oficinas/Facções)
  HYBRID // Faz os dois
}

model Supplier {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status SimpleStatus @default(ACTIVE) @map("status")
  name   String       @db.VarChar(120)

  document String? @unique @db.VarChar(18)
  email    String? @db.VarChar(120)
  phone    String? @db.VarChar(20)

  category SupplierCategory @default(MATERIAL_ONLY) @map("categoria")

  address    String? @db.VarChar(200)
  city       String? @db.VarChar(100)
  state      String? @db.VarChar(2)
  zipCode    String? @db.VarChar(10)
  complement String? @db.VarChar(200)
  // Novos campos recomendados
  numero     String? @map("numero") @db.VarChar(20)
  bairro     String? @map("bairro") @db.VarChar(100)

  latitude  Float? @map("latitude")
  longitude Float? @map("longitude")

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Controle de Criação/Atualização
  userCreate   User     @relation("SupplierCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("SupplierUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  supplierMaterials SupplierMaterial[]
  flowItems         FlowItem[]

  @@map("suppliers")
}

model Material {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status SimpleStatus @default(ACTIVE) @map("status")
  type   String       @map("tipo") @db.VarChar(50)

  name        String  @map("nome") @db.VarChar(100)
  description String? @map("descricao") @db.VarChar(200)
  color       String? @map("cor") @db.VarChar(50)

  unitOfMeasure String @map("unidade_medida") @db.VarChar(20)
  yieldPerKg    Int    @map("rendimento_por_kg")

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyMaterials", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Controle de Criação/Atualização
  userCreate   User     @relation("MaterialCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("MaterialUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  products          ProductMaterial[]
  supplierMaterials SupplierMaterial[]
  budgetMaterials   BudgetMaterial[]

  @@index([companyId])
  @@index([type])
  @@index([description])
  @@map("materiais")
}

model SupplierMaterial {
  id          String  @id @default(uuid()) @map("id") @db.Uuid
  isPreferred Boolean @default(false) @map("fornecedor_preferencial")

  unitPrice     Decimal @map("valor_unitario_fornecedor") @db.Decimal(10, 4)
  pricePerKg    Decimal @map("valor_por_kg_fornecedor") @db.Decimal(10, 4)
  pricePerMeter Decimal @map("valor_por_metro_fornecedor") @db.Decimal(10, 4)

  supplierRefCode String  @map("codigo_fornecedor") @db.VarChar(50)
  leadTimeDays    Int?    @map("prazo_entrega_dias")
  notes           String? @map("observacoes") @db.VarChar(500)

  // Relacionamentos
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String   @map("fornecedor_id") @db.Uuid

  material   Material @relation(fields: [materialId], references: [id])
  materialId String   @map("material_id") @db.Uuid

  // Controle de Criação/Atualização
  userCreate   User     @relation("SupplierMaterialCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("SupplierMaterialUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  budgetMaterials BudgetMaterial[]

  @@unique([supplierId, materialId])
  @@index([supplierId])
  @@index([materialId])
  @@map("materiais_fornecedores")
}

model Product {
  id       String       @id @default(uuid()) @map("id") @db.Uuid
  status   SimpleStatus @default(ACTIVE) @map("status")
  referece String?      @unique @map("referencia") @db.VarChar(50)

  name        String  @map("nome") @db.VarChar(150)
  description String? @map("descricao") @db.Text

  custoUnitario Decimal @map("custo_unitario") @db.Decimal(10, 4)
  sizeRange     String? @map("faixa_tamanhos") @db.VarChar(50)

  // Relacionamento com Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyProducts", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Controle de Criação/Atualização
  userCreate   User     @relation("ProductCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("ProductUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  materials   ProductMaterial[]
  budgetItems BudgetProduct[]

  @@index([companyId])
  @@index([referece])
  @@map("produtos")
}

model ProductMaterial {
  quantidade Decimal @map("quantidade") @db.Decimal(10, 4)

  // Relacionamentos
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("produto_id") @db.Uuid

  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialId String   @map("material_id") @db.Uuid

  // Controle de Criação/Atualização
  userCreate   User     @relation("ProductMaterialCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("ProductMaterialUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  @@id([productId, materialId])
  @@index([productId])
  @@index([materialId])
  @@map("produtos_materiais")
}

model Budget {
  id     String       @id @default(uuid()) @map("id") @db.Uuid
  status BudgetStatus @default(PENDING) @map("status")
  title  String       @map("titulo") @db.VarChar(200)

  total    Decimal   @map("total") @db.Decimal(12, 2)
  validity DateTime? @map("validade")

  paymentMethod String? @map("forma_pagamento") @db.VarChar(50)

  // Usuários
  userAssignedId String    @map("atribuido_para_id") @db.Uuid
  userAssigned   User      @relation("BudgetAssignedTo", fields: [userAssignedId], references: [id])
  answeredAt     DateTime? @map("respondido_em")

  // Agrupamento
  budgetGroupId String?      @map("grupo_orcamento_id") @db.Uuid
  budgetGroup   BudgetGroup? @relation("BudgetGroupBudgets", fields: [budgetGroupId], references: [id])

  // Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation("CompanyBudgets", fields: [companyId], references: [id], onDelete: Cascade) // Consolidado

  // Tarefa (Opcional)
  taskId String? @db.Uuid
  task   Task?   @relation("TaskAssociation", fields: [taskId], references: [id])

  // Controle de Criação/Atualização
  userCreate   User     @relation("BudgetCreatedBy", fields: [userCreateId], references: [id])
  userCreateId String   @map("user_create_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("criado_em")

  userUpdate   User?    @relation("BudgetUpdatedBy", fields: [userUpdateId], references: [id])
  userUpdateId String?  @map("user_update_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos Reversos
  products         BudgetProduct[]
  materials        BudgetMaterial[]
  approvedForGroup BudgetGroup?     @relation("BudgetGroupApprovedBudget")

  tasks Task[]

  @@index([companyId])
  @@index([userCreateId])
  @@index([userAssignedId])
  @@index([status])
  @@index([createdAt])
  @@index([validity])
  @@map("orcamentos")
}

model BudgetProduct {
  id String @id @default(uuid()) @map("id") @db.Uuid

  quantity Int @map("quantidade")

  unitCostSnapshot  Decimal @map("custo_unitario_snapshot") @db.Decimal(10, 4)
  totalCostSnapshot Decimal @map("custo_total_snapshot") @db.Decimal(12, 4)

  // Relacionamentos
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId String @map("orcamento_id") @db.Uuid

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String  @map("produto_id") @db.Uuid

  @@index([budgetId])
  @@index([productId])
  @@map("orcamentos_produtos")
}

model BudgetMaterial {
  id String @id @default(uuid()) @map("id") @db.Uuid

  quantityNeeded Decimal @map("quantidade_necessaria") @db.Decimal(12, 4)
  unitPrice      Decimal @map("valor_unitario") @db.Decimal(10, 4)
  totalPrice     Decimal @map("valor_total") @db.Decimal(12, 4)

  // Relacionamentos
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId String @map("orcamento_id") @db.Uuid

  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialId String   @map("material_id") @db.Uuid

  supplierMaterial   SupplierMaterial? @relation(fields: [supplierMaterialId], references: [id])
  supplierMaterialId String?           @map("material_fornecedor_id") @db.Uuid

  @@index([budgetId])
  @@index([materialId])
  @@index([supplierMaterialId])
  @@map("orcamentos_materiais")
}

model BudgetGroup {
  id     String            @id @default(uuid()) @map("id") @db.Uuid
  status BudgetGroupStatus @default(PENDING) @map("status")

  title String? @map("nome") @db.VarChar(150)

  // Controle de Criação
  userCreateId String   @map("user_create_id") @db.Uuid
  userCreate   User     @relation("BudgetGroupCreatedBy", fields: [userCreateId], references: [id])
  createdAt    DateTime @default(now()) @map("criado_em")

  // Atribuído
  userAssignedId String @map("atribuido_para_id") @db.Uuid
  userAssigned   User   @relation("BudgetGroupAssignedTo", fields: [userAssignedId], references: [id])

  // Empresa
  companyId String  @map("empresa_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Orçamento Aprovado (Foreign Key para Budget)
  budgetApprovedId String? @unique @map("orcamento_aprovado_id") @db.Uuid
  budgetApproved   Budget? @relation("BudgetGroupApprovedBudget", fields: [budgetApprovedId], references: [id])

  // Relacionamento Reversos
  budgets Budget[] @relation("BudgetGroupBudgets")

  @@index([companyId])
  @@index([userCreateId])
  @@index([userAssignedId])
  @@map("grupos_orcamentos")
}

model Chat {
  id String @id @default(uuid()) @map("id") @db.Uuid

  // Relacionamento com Empresa
  companyId String?  @map("empresa_id") @db.Uuid
  company   Company? @relation("CompanyChats", fields: [companyId], references: [id]) // Consolidado

  createdAt DateTime @default(now()) @map("criado_em")

  // Relacionamentos Reversos
  messages ChatMessage[]

  @@index([companyId])
  @@map("chats")
