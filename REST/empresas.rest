### ============================================================================
### 3. LISTAGEM (GET ALL)
### ============================================================================

# [SUCESSO] Listar Tudo como MASTER
# Deve ver TODAS as empresas cadastradas
GET {{baseUrl}}/companies?page=1&limit=10
Authorization: Bearer {{tokenMaster}}

###

# [SUCESSO PARCIAL] Listar como ADMIN (Filtro Automático)
# Deve retornar array com APENAS 1 item (a empresa dele)
GET {{baseUrl}}/companies?page=1&limit=10
Authorization: Bearer {{tokenAdmin}}

###

# [ERRO] Listar como EMPLOYER (RBAC)
# Funcionário não deve ter acesso a lista de empresas (geralmente)
# Deve retornar 403 Forbidden
GET {{baseUrl}}/companies
Authorization: Bearer {{tokenEmployer}}

### ============================================================================
### 4. BUSCA POR ID (GET ONE)
### ============================================================================

# [SUCESSO] MASTER busca qualquer empresa
GET {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenMaster}}

###

# [SUCESSO] ADMIN busca SUA própria empresa
GET {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenAdmin}}

###

# [ERRO DE SEGURANÇA - IDOR] ADMIN busca OUTRA empresa
# O Admin tenta acessar o ID de outra empresa.
# Deve retornar 403 Forbidden (Bloqueado pelo Service/Contexto)
GET {{baseUrl}}/companies/{{otherCompanyId}}
Authorization: Bearer {{tokenAdmin}}

### ============================================================================
### 5. ATUALIZAÇÃO (PATCH)
### ============================================================================

# [SUCESSO] MASTER atualiza dados
PATCH {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{tokenMaster}}

{
  "name": "Nome Atualizado pelo Master",
  "ramoAtividade": "Alta Costura"
}

###

# [SUCESSO] ADMIN atualiza sua PRÓPRIA empresa
PATCH {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "telefone": "11988887777",
  "complemento": "Galpão B"
}

###

# [ERRO] ADMIN tenta INATIVAR a própria empresa (Regra de Negócio)
# Só Master pode inativar. Deve retornar 403 Forbidden.
PATCH {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "status": "INACTIVE"
}

###

# [ERRO - IDOR] ADMIN tenta alterar OUTRA empresa
PATCH {{baseUrl}}/companies/{{otherCompanyId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Hacked by Admin"
}

### ============================================================================
### 6. REMOÇÃO (DELETE)
### ============================================================================

# [ERRO] ADMIN tenta deletar empresa (Mesmo sendo a dele)
# Deve retornar 403 Forbidden
DELETE {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenAdmin}}

###

# [ERRO] EMPLOYER tenta deletar empresa
# Deve retornar 403 Forbidden
DELETE {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenEmployer}}

###

# [SUCESSO] MASTER inativa (Soft Delete) a empresa
# Deve retornar 204 No Content
DELETE {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{tokenMaster}}