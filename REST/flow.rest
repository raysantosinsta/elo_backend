@baseUrl = http://localhost:3000

### ====================================================
### 🔐 1. LOGIN - EXECUTE ISSO PRIMEIRO
### ====================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "highadm@gmail.com",
  "password": "senha123"
}

### APÓS EXECUTAR O LOGIN ACIMA, COPIE O access_token E COLE NA LINHA ABAIXO
@authToken = COLE_SEU_TOKEN_AQUI

### ====================================================
### 📋 2. CRIAR FLUXO
### ====================================================
POST {{baseUrl}}/flow
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Coleção Verão 2025",
  "color": "#3498db",
  "deadline": "2025-12-31T23:59:59.999Z"
}

### APÓS CRIAR O FLUXO, COPIE O ID E COLE NA LINHA ABAIXO
@flowId = COLE_O_FLOW_ID_AQUI

### ====================================================
### 🏷️ 3. CRIAR ETAPA 1 - MODELAGEM
### ====================================================
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Modelagem",
  "color": "#2ecc71",
  "allowedRole": "modelista",
  "suggestedDeadline": 5
}

### APÓS CRIAR A ETAPA 1, COPIE O ID E COLE NA LINHA ABAIXO
@stageId1 = COLE_O_STAGE_ID_1_AQUI

### ====================================================
### 🏷️ 4. CRIAR ETAPA 2 - CORTE
### ====================================================
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Corte",
  "color": "#e74c3c",
  "allowedRole": "cortador",
  "suggestedDeadline": 3
}

@stageId2 = COLE_O_STAGE_ID_2_AQUI

### ====================================================
### 🏷️ 5. CRIAR ETAPA 3 - COSTURA
### ====================================================
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Costura",
  "color": "#f39c12",
  "allowedRole": "costureira",
  "suggestedDeadline": 7
}

@stageId3 = COLE_O_STAGE_ID_3_AQUI

### ====================================================
### 🏷️ 6. CRIAR ETAPA 4 - ACABAMENTO
### ====================================================
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Acabamento",
  "color": "#9b59b6",
  "allowedRole": "acabador",
  "suggestedDeadline": 2
}

@stageId4 = COLE_O_STAGE_ID_4_AQUI

### ====================================================
### 🏷️ 7. CRIAR ETAPA 5 - DISTRIBUIÇÃO
### ====================================================
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Distribuição",
  "color": "#1abc9c",
  "allowedRole": "expedidor",
  "suggestedDeadline": 1
}

@stageId5 = COLE_O_STAGE_ID_5_AQUI

### ====================================================
### 📋 8. LISTAR ETAPAS DO FLUXO
### ====================================================
GET {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{authToken}}

### ====================================================
### 📦 9. CRIAR ITEM COM PRAZOS
### ====================================================
POST {{baseUrl}}/flow/items/with-stages
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "flowId": "{{flowId}}",
  "title": "Camisa Social Azul",
  "orderNumber": "PED-2025-001",
  "productRef": "CAM-001",
  "quantity": 50,
  "priority": 3,
  "dueDate": "2025-04-30T23:59:59.999Z",
  "productionStartedAt": "2025-03-19T10:00:00.000Z",
  "description": "Camisa social manga longa, tecido azul",
  "stageId": "{{stageId1}}"
}

### APÓS CRIAR O ITEM, COPIE O ID E COLE NA LINHA ABAIXO
@itemId1 = COLE_O_ITEM_ID_AQUI

### ====================================================
### 📦 10. CRIAR ITEM SIMPLES
### ====================================================
POST {{baseUrl}}/flow/items
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "flowId": "{{flowId}}",
  "title": "Calça Jeans",
  "orderNumber": "PED-2025-002",
  "productRef": "CAL-001",
  "quantity": 30,
  "priority": 2,
  "dueDate": "2025-05-15T23:59:59.999Z",
  "stageId": "{{stageId2}}"
}

@itemId2 = COLE_O_ITEM_ID_2_AQUI

### ====================================================
### 🔍 11. LISTAR TODOS OS ITENS
### ====================================================
GET {{baseUrl}}/flow/filter/items
Authorization: Bearer {{authToken}}

### ====================================================
### 📊 12. VER KANBAN BOARD
### ====================================================
GET {{baseUrl}}/flow/{{flowId}}/board
Authorization: Bearer {{authToken}}

### ====================================================
### ⏰ 13. BUSCAR PRAZOS DO ITEM
### ====================================================
GET {{baseUrl}}/flow/items/{{itemId1}}/stages
Authorization: Bearer {{authToken}}

### ====================================================
### ⏰ 14. ATUALIZAR PRAZO DA ETAPA
### ====================================================
PATCH {{baseUrl}}/flow/items/{{itemId1}}/stages/{{stageId1}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "suggestedDeadline": "2025-03-25T23:59:59.999Z",
  "actualDeadline": "2025-03-24T18:30:00.000Z",
  "status": "CONCLUIDO",
  "notes": "Modelagem concluída"
}

### ====================================================
### 🎯 15. MOVER ITEM
### ====================================================
POST {{baseUrl}}/flow/items/{{itemId1}}/move-with-deadline
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newStageId": "{{stageId2}}",
  "newOrder": 0
}

### ====================================================
### 📈 16. DASHBOARD DE PRAZOS
### ====================================================
GET {{baseUrl}}/flow/deadline-dashboard?flowId={{flowId}}
Authorization: Bearer {{authToken}}

### ====================================================
### 🗑️ 17. DELETAR ITEM (OPCIONAL)
### ====================================================
DELETE {{baseUrl}}/flow/items/{{itemId1}}
Authorization: Bearer {{authToken}}