# ==============================================================================
# 1️⃣ GESTÃO DE FLUXOS (ESTEIRAS)
# ==============================================================================

### 1.1 Listar Fluxos da Empresa
GET {{baseUrl}}/flow
Authorization: Bearer {{token}}

### 1.2 Criar Novo Fluxo
# Requer Permissão: MANAGE_FLOW (Admin/Gestor)
POST {{baseUrl}}/flow
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Coleção Inverno 2026",
  "color": "#8E44AD"
}

### 1.3 Deletar Fluxo
DELETE {{baseUrl}}/flow/{{flowId}}
Authorization: Bearer {{token}}

### 1.4 Ver Quadro Kanban Completo (Board)
GET {{baseUrl}}/flow/{{flowId}}/board
Authorization: Bearer {{token}}

# ==============================================================================
# 2️⃣ GESTÃO DE ETAPAS (COLUNAS)
# ==============================================================================

### 2.1 Criar Etapa (Stage)
# allowedRole: Defina quem pode mover cards desta coluna (ex: "modelista", "piloteira")
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Modelagem",
  "color": "#2980B9",
  "allowedRole": "modelista" 
}

### 2.2 Criar Outra Etapa (Para teste de movimento)
POST {{baseUrl}}/flow/{{flowId}}/stages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pilotagem",
  "color": "#27AE60",
  "allowedRole": "piloteira"
}

### 2.3 Atualizar Etapa
PUT {{baseUrl}}/flow/stages/{{stageId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Modelagem (Revisão)",
  "allowedRole": "modelista"
}

### 2.4 Deletar Etapa
DELETE {{baseUrl}}/flow/stages/{{stageId}}
Authorization: Bearer {{token}}

# ==============================================================================
# 3️⃣ GESTÃO DE ITENS (CARDS)
# ==============================================================================

### 3.1 Criar Item (Produto)
# stageId: Opcional. Se não enviar, vai para a primeira etapa.
POST {{baseUrl}}/flow/{{flowId}}/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Camisa Polo Algodão",
  "productRef": "REF-2026-A",
  "quantity": 100,
  "priority": 1,
  "description": "Utilizar linha 100% algodão.",
  "stageId": "{{stageId}}" 
}

### 3.2 Atualizar Item
PUT {{baseUrl}}/flow/items/{{itemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 150,
  "description": "Atualização: Urgente."
}

### 3.3 Filtrar Itens
# Ex: ?onlyOutsourced=true&startDate=2024-01-01&endDate=2024-12-31&dateField=createdAt
GET {{baseUrl}}/flow/filter/items?onlyOutsourced=false
Authorization: Bearer {{token}}

### 3.4 Deletar Item
DELETE {{baseUrl}}/flow/items/{{itemId}}
Authorization: Bearer {{token}}

# ==============================================================================
# 4️⃣ MOVIMENTAÇÃO (AÇÃO)
# ==============================================================================

### 4.1 Mover Item (Drag & Drop)
# Simula o arrastar do card. O usuário logado deve ter o cargo da etapa de ORIGEM.
# newStageId: ID da etapa de DESTINO.
PUT {{baseUrl}}/flow/items/{{itemId}}/move
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newStageId": "ID_DA_ETAPA_DE_DESTINO_AQUI"
}

### 4.2 Avançar Item (Botão Automático "Concluir")
# Move para a próxima etapa na sequência numérica.
# Requer permissão MANAGE_FLOW_ITEMS (Todos logados) + Cargo da Etapa.
POST {{baseUrl}}/flow/items/{{itemId}}/advance
Authorization: Bearer {{token}}

# ==============================================================================
# 5️⃣ TEMPLATES
# ==============================================================================

### 5.1 Salvar Fluxo Atual como Template
POST {{baseUrl}}/flow/{{flowId}}/save-template
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Template Padrão Camisetas"
}

### 5.2 Listar Templates
GET {{baseUrl}}/flow/templates
Authorization: Bearer {{token}}

### 5.3 Aplicar Template em um Fluxo
POST {{baseUrl}}/flow/{{flowId}}/apply-template/{{templateId}}
Authorization: Bearer {{token}}

### 5.4 Deletar Template
DELETE {{baseUrl}}/flow/templates/{{templateId}}
Authorization: Bearer {{token}}

# ==============================================================================
# 6️⃣ MÍDIAS (UPLOAD)
# ==============================================================================

### 6.1 Upload de Imagem/Audio/Video
# Nota: Para testar upload no VS Code REST Client, você precisa de um arquivo real.
# Substitua o caminho do arquivo abaixo.
# Types: image, audio, video
POST {{baseUrl}}/flow/items/{{itemId}}/media/image
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="teste.png"
Content-Type: image/png

< ./caminho/para/sua/imagem.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 6.2 Deletar Mídia
DELETE {{baseUrl}}/flow/items/{{itemId}}/media/image/{{mediaId}}
Authorization: Bearer {{token}}

