NODE_ENV=development
PORT=3000
BODY_LIMIT=10mb

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,https://app.seudominio.com.br

ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=
ASAAS_CHECKOUT_SUCCESS_URL=http://localhost:3001/billing
ASAAS_WEBHOOK_URL=http://localhost:3000/billing/asaas/webhook
BACKEND_URL=http://localhost:3000

BILLING_ACCESS_GUARD_ENABLED=true
PARTNER_COMMISSION_HOLD_DAYS=7
