### Variáveis de ambiente
@baseUrl = http://localhost:3000
@contentType = application/json

### IDs para teste (substitua pelos IDs reais do seu banco)
@userId = 12345678-1234-1234-1234-123456789012
@companyId = 87654321-4321-4321-4321-210987654321
@email = usuario.teste@empresa.com
@document = 123.456.789-00

### 1. CRIAR USUÁRIO
POST {{baseUrl}}/users
Content-Type: {{contentType}}

{
  "name": "João Silva",
  "email": "{{email}}",
  "password": "senha123",
  "document": "{{document}}",
  "role": "EMPLOYER",
  "isProfessional": true,
  "professionalRole": "Gerente de Projetos",
  "phone": "(11) 99999-9999",
  "companyId": "{{companyId}}"
}

